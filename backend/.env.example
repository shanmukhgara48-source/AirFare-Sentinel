# FarePulse India — APIx backend environment configuration
# Copy this file to .env and fill in the values for your environment.
# The application runs fine with no .env file (demo mode, provider calls disabled).
#
# NEVER commit your real .env to version control.
# The .gitignore already excludes .env files.

# ── Preferred live data provider: Ignav ──────────────────────────────────────
# Backend only. Never put this key in VITE_* variables or frontend files.
# Obtain a key at https://ignav.com and keep the real value in backend/.env.
IGNAV_API_KEY=
IGNAV_BASE_URL=https://ignav.com/api
# Optional external MCP integration: https://ignav.com/mcp
# The application uses REST fare search directly; no MCP client is required.

# ── Fallback live data provider: Amadeus ──────────────────────────────────────
# To enable provider fare data from the Amadeus test environment:
#   1. Register at https://developers.amadeus.com (free)
#   2. Create an app in the developer portal
#   3. Copy both the client_id and client_secret from the app settings
# A single browser/API key is not sufficient. Keep both values backend-only.
#
# Leave blank to use local demo/imported data only (default, safe for hackathon).
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Default: Amadeus test environment. Change to production URL when approved.
# AMADEUS_BASE_URL=https://test.api.amadeus.com

# ── Application mode ─────────────────────────────────────────────────────────
# Set to "false" to enable live data ingestion when a provider is configured.
# Requires IGNAV_API_KEY or both Amadeus credentials. Ignav is preferred.
# Default: "true" (provider calls disabled — safe for demo)
# DEMO_MODE=true

# ── CORS origins ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Default: localhost:5173 (Vite dev server) only.
# For a deployed frontend, add its exact origin here. Wildcards are rejected.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Upload limits ─────────────────────────────────────────────────────────────
# Maximum CSV upload size in bytes. Default: 5242880 (5 MB, ~100,000 rows).
# UPLOAD_MAX_BYTES=5242880

# Configuration is validated at startup. Invalid booleans, partial provider
# credentials, wildcard/empty CORS origins, insecure remote provider URLs, and
# non-positive upload limits fail fast without printing credential values.
# See ../docs/LIVE_DATA_READINESS.md before enabling provider ingestion.

# Enforce live analytical data and disable demo/CSV ingestion in this deployment.
# Requires DEMO_MODE=false. Defaults to false for demo/import compatibility.
LIVE_ONLY=false
# Optional dedicated database path for live snapshots (backend only).
# FAREPULSE_DB_PATH=/absolute/path/to/live_airfares.db
