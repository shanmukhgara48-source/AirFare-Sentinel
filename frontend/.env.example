# Public backend origin for a separately hosted frontend, without a trailing
# slash or /api suffix. Leave blank for same-origin hosting or local proxying.
# This value is compiled into browser JavaScript and must never contain secrets.
VITE_API_ORIGIN=

# Dev/preview proxy target. This remains a local Node/Vite setting and is not
# included in the browser bundle.
# FAREPULSE_API_URL=http://localhost:8000
